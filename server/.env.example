# Server Port (Render sets this dynamically)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moneymate?retryWrites=true&w=majority

# JWT Secret Key (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL (for CORS allowance)
# Local:
CLIENT_URL=http://localhost:5173
# Production (set to your Vercel URL):
# CLIENT_URL=https://your-moneymate.vercel.app

# Optional AI Providers (optional - deterministic analytics fallback works without keys)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
